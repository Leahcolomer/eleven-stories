# Clé API Resend (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Adresse qui reçoit les demandes du formulaire « Parlons-en »
CONTACT_TO_EMAIL=elevenstories.pr@gmail.com

# Expéditeur. Tant que le domaine n'est pas vérifié dans Resend, garder onboarding@resend.dev
# (en mode test, Resend n'envoie alors qu'à l'adresse du compte Resend).
# Une fois elevenstories.fr vérifié : Eleven Stories <contact@elevenstories.fr>
CONTACT_FROM_EMAIL=Eleven Stories <onboarding@resend.dev>
